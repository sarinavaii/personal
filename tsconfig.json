{
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "incremental": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@styles/*": ["./src/styles/*"],
            "@templates/*": ["./src/templates/*"],
            "@core/*": ["./src/core/*"],
            "@lib/*": ["./src/lib/*"],
            "@layout/*": ["./src/components/layout/*"],
            "@ui/*": ["./src/components/ui/*"],
            "@sections/*": ["./src/components/sections/*"],
            "@public/*": ["./public/*"],
            "@velite": ["./velite"]
        }
    },
    "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "velite"],
    "exclude": ["node_modules"]
}
